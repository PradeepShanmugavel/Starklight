# Copy to backend/.env and fill in. backend/.env is gitignored.
# Every key is optional: a provider with no key is skipped and the AI
# fallback chain moves to the next one.

GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=

# Postgres connection string for Topic Align report history.
# Leave blank to run without history (the feature degrades, nothing crashes).
# Neon example: postgresql://user:pass@ep-xxx.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Optional: extra directories to search for local compilers/interpreters.
# Windows uses ';' as the separator, macOS/Linux ':'.
EXTRA_TOOLCHAIN_PATHS=

# ── Needed by QBForge's own Solution Manager backend (qbforge-routes/) ──────
# REQUIRED for Solution Manager — the rest of Starlight doesn't use these.
EXAMLY_BASE_URL=https://api.examly.io
SCHOOL_ID=
